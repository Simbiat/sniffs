{
    "name": "simbiat/sniffs",
    "type": "library",
    "keywords": [
        "php",
        "sat",
        "sniff",
        "sniffer",
        "phpcs"
    ],
    "description": "Custom sniffs for PHP Code Sniffer",
    "homepage": "https://github.com/Simbiat/sniffs",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Dmitrii Kustov",
            "email": "support@simbiat.eu",
            "homepage": "https://www.simbiat.eu",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "squizlabs/php_codesniffer": "^4.0.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simbiat\\Sniffs\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "support": {
        "issues": "https://github.com/Simbiat/sniffs/issues",
        "source": "https://github.com/Simbiat/sniffs"
    }
}
